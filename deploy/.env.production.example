# Public HTTPS origin without a trailing slash.
SERVER_ADDRESS=https://api.example.com

# Use URL-safe random values because the database and Redis passwords are
# embedded in connection URLs.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-long-url-safe-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CRYPTO_SECRET=replace-with-at-least-32-random-characters

TZ=Asia/Shanghai
NODE_NAME=new-api-node-1

# The application remains private to the host reverse proxy by default.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Verify the public URL after the local health check succeeds.
VERIFY_EXTERNAL=true
